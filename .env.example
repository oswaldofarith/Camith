# Copiar a .env en la raíz del proyecto en el VPS y completar.

# Dominio público (Caddy obtiene el certificado HTTPS automáticamente).
DOMAIN=app.tudominio.com

# PostgreSQL
POSTGRES_DB=camith
POSTGRES_USER=camith
POSTGRES_PASSWORD=cambia-esta-clave

# Django
DJANGO_SECRET_KEY=genera-una-clave-larga-y-aleatoria
DJANGO_ALLOWED_HOSTS=app.tudominio.com,backend,localhost
DJANGO_CSRF_TRUSTED_ORIGINS=https://app.tudominio.com
FRONTEND_URL=https://app.tudominio.com

# Correo saliente (reseteo de contraseñas)
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.tuproveedor.com
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=AMI-FieldWorkManager <no-reply@tudominio.com>
